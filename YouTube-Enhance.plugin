#!name = YouTube (Music) Enhance
#!desc = YouTube 与 YouTube Music 去广告、画中画及后台播放增强（Maasea Surge 模块 Loon 转换版）
#!author = Maasea（Loon 格式转换）
#!icon = https://raw.githubusercontent.com/ucuw/icon/main/Youtube.png
#!homepage = https://github.com/Maasea/sgmodule

[Script]
# 响应体过滤：移除 YouTube 接口返回中的广告及相关内容
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$ script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,requires-body=true,binary-body-mode=true,timeout=60,tag=YouTube Enhance Response,argument="{\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"

# YouTube 播放初始化请求处理
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,requires-body=true,binary-body-mode=true,timeout=20,tag=YouTube Enhance Request,argument="{\"captionLang\":\"off\"}"

# YouTube log_event 请求处理
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,timeout=20,tag=YouTube Enhance Log Event

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com
